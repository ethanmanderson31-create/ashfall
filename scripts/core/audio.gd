var _cache := {}
var _seq := {}
var _loops := {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for b in ["Effects", "Creatures", "Ambience"]:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, b)
			AudioServer.set_bus_send(i, "Master")
	apply_volumes()


func apply_volumes() -> void:
	var vols := {"Master": Settings.vol_master, "Effects": Settings.vol_effects, "Creatures": Settings.vol_creatures, "Ambience": Settings.vol_ambience}
	for b in vols:
		var i := AudioServer.get_bus_index(b)
		if i >= 0:
			var v: float = vols[b]
			AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.0001)))
			AudioServer.set_bus_mute(i, v <= 0.001)


func _files(slot: String) -> Array:
	var opts: Dictionary = SOUNDS.get(slot, {})
	return opts.get(PICKS.get(slot, "A"), opts.get("A", []))


func _stream(path: String) -> AudioStream:
	if not _cache.has(path):
		_cache[path] = load(path)
	return _cache[path]


## Picks one file from the slot. `index` >= 0 selects a specific file
## (sequences, e.g. reload steps); otherwise a random variant.
func stream_for(slot: String, index := -1) -> AudioStream:
	var files := _files(slot)
	if files.is_empty():
		return null
	var i := index if index >= 0 else randi() % files.size()
	return _stream(files[clampi(i, 0, files.size() - 1)])


## Plays a slot. With `at` it's positional (3D) in the world; otherwise flat.
func play(slot: String, at: Variant = null, volume_db := 0.0, pitch := 1.0, pitch_jitter := 0.06, index := -1) -> Node:
	var s := stream_for(slot, index)
	if s == null or Game.world == null:
		return null
	var p: Node
	if at is Vector3:
		var p3 := AudioStreamPlayer3D.new()
		p3.stream = s
		p3.volume_db = volume_db
		p3.unit_size = 6.0
		p3.max_distance = 90.0
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p3.bus = BUS.get(slot, "Effects")
		p3.pitch_scale = pitch * randf_range(1.0 - pitch_jitter, 1.0 + pitch_jitter)
		Game.world.add_child(p3)
		p3.global_position = at
		p3.play()
		p = p3
	else:
		var p2 := AudioStreamPlayer.new()
		p2.stream = s
		p2.volume_db = volume_db
		p2.bus = BUS.get(slot, "Effects")
		p2.pitch_scale = pitch * randf_range(1.0 - pitch_jitter, 1.0 + pitch_jitter)
		p2.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(p2)
		p2.play()
		p = p2
	p.finished.connect(p.queue_free)
	return p


## Looping ambience, positional when `parent` is a Node3D.
func loop(slot: String, parent: Node, volume_db := 0.0, unit := 4.0, max_dist := 30.0) -> Node:
	var s := stream_for(slot)
	if s == null:
		return null
	if s is AudioStreamWAV:
		var w := (s as AudioStreamWAV).duplicate() as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		s = w
	var p: Node
	if parent is Node3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.stream = s
		p3.volume_db = volume_db
		p3.unit_size = unit
		p3.max_distance = max_dist
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_SQUARE_DISTANCE
		p3.bus = BUS.get(slot, "Ambience")
		parent.add_child(p3)
		p3.play(randf() * maxf(s.get_length() - 0.1, 0.0))
		p = p3
	else:
		var p2 := AudioStreamPlayer.new()
		p2.stream = s
		p2.volume_db = volume_db
		p2.bus = BUS.get(slot, "Ambience")
		parent.add_child(p2)
		p2.play()
		p = p2
	return p
